# Environment variables read by the backend (see application.properties,
# application-production.properties). Copy this file to .env (already gitignored),
# or set these as real environment variables in your deployment platform — never
# commit an actual .env file or real secret values anywhere in the repository.
#
# None of the values below are real secrets: they are either placeholders you must
# replace, or the safe defaults already used when a variable is left unset.

# ---- Spring profile -------------------------------------------------------------
# Required in production. Left unset, the application defaults to the "local"
# profile (see application.properties) — safe for a developer's machine, but never
# what a real deployment wants: SPRING_PROFILES_ACTIVE=production activates
# application-production.properties and ProductionSecurityGuard's startup checks.
SPRING_PROFILES_ACTIVE=production

# ---- Database (spring-boot standard relaxed binding, not declared in any
#      application*.properties file in this repo) --------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/assrone_db
SPRING_DATASOURCE_USERNAME=changeme
SPRING_DATASOURCE_PASSWORD=changeme

# ---- Hibernate schema mode (see LegacyBaselineFlywayCallback for how the schema gets
#      built without Hibernate's help, even on a completely empty database) ------------
# Flyway is the sole schema owner everywhere, always applied before Hibernate/JPA is
# built. ddl-auto is therefore always "validate" — in production
# (application-production.properties hardcodes it, not overridable by this variable
# there) and locally by this same default. Hibernate never creates or alters a table or
# column, on any database, including a genuinely fresh one. There is no supported value
# other than "validate" for this variable; it exists only so a test can override it
# locally if it deliberately needs to (see e.g. BackendApplicationTests), never as a
# real per-environment choice.
JPA_DDL_AUTO=validate

# ---- JWT signing key --------------------------------------------------------------
# Must decode from Base64 to exactly 48 bytes (HS384). Generate one with, e.g.:
#   openssl rand -base64 48
# The placeholder below is deliberately NOT valid Base64/NOT 48 bytes: JwtService
# refuses to start with it, in every profile, so it can never be forgotten by accident.
JWT_SECRET=changeme-generate-with-openssl-rand-base64-48

# ---- SMTP -----------------------------------------------------------------------
# Required in production (no default there — see application-production.properties);
# in local dev these default to Mailpit (see docker-compose.yml), no authentication
# needed, so none of these four need to be set locally at all.
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_USERNAME=noreply@assrone.ch
SMTP_PASSWORD=changeme

# ---- CORS ---------------------------------------------------------------------------
# Comma-separated list of the real deployed frontend origin(s). Required in production
# (no default there — see application-production.properties); defaults to
# http://localhost:4200 everywhere else. Never "*" — CorsProperties refuses to start
# the application, in every profile, if this contains a wildcard.
CORS_ALLOWED_ORIGINS=https://assrone.ch

# ---- Refresh-token cookie ----------------------------------------------------------
# All optional; shown here with their defaults. See RefreshCookieProperties and
# ProductionSecurityGuard for the validation/startup checks on these.
REFRESH_COOKIE_NAME=refresh_token
# Defaults to true in production (application-production.properties), false elsewhere.
# ProductionSecurityGuard refuses to start the application if this resolves to false
# while SPRING_PROFILES_ACTIVE=production.
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAME_SITE=Lax
REFRESH_COOKIE_PATH=/auth

# ---- Reverse proxy (only if one sits in front of the app in production) -----------
# Comma-separated list of IPs/CIDR ranges allowed to supply X-Forwarded-For. Leave
# unset (the default everywhere) if there is no reverse proxy in front of the app.
# Never a wildcard/0.0.0.0/0-style range.
TRUSTED_PROXIES=

# ---- Content-Security-Policy ------------------------------------------------------
# Whether the CSP tells the browser to rewrite any http: sub-resource request to
# https: before sending it (see ContentSecurityPolicy/SecurityConfig). Defaults to
# false everywhere except production (true there) — see application-production.properties.
# Only meaningful when the app is actually served over HTTPS; never set true locally.
CSP_UPGRADE_INSECURE_REQUESTS=true

# ---- Session management (see SessionProperties, SessionService, SessionCleanupService) ---
# All optional; shown here with their defaults.
# Max concurrent active sessions per account before the oldest is revoked to make room.
SESSIONS_MAX_ACTIVE=5
# Scheduled purge of old revoked/expired sessions. Safe to leave enabled in production;
# the test suite disables it separately (src/test/resources/application-local.properties).
SESSIONS_CLEANUP_ENABLED=true
# Standard 6-field cron (seconds included), evaluated in the server's local time zone.
SESSIONS_CLEANUP_CRON=0 0 3 * * *
# How long a revoked or expired session's row (and its refresh tokens) is kept around
# after it stops being usable, before the cleanup job deletes it. Accepts Spring Boot's
# simple duration syntax (e.g. 7d, 24h). Kept this long so RefreshTokenService#rotate can
# still tell a legitimate revocation apart from real token reuse for that long.
SESSIONS_CLEANUP_RETENTION=7d

# ---- Account lifecycle: password reset / email verification (see
#      AccountLifecycleProperties, PasswordResetService, EmailVerificationService,
#      AccountLifecycleTokenCleanupService) --------------------------------------------
# The frontend origin used to build password-reset and email-verification links sent by
# email. Required in production (no default there — see application-production.properties,
# same reasoning as CORS_ALLOWED_ORIGINS); defaults to http://localhost:4200 elsewhere.
ACCOUNT_LIFECYCLE_FRONTEND_URL=https://assrone.ch
# All below are optional; shown here with their defaults. Accepts Spring Boot's simple
# duration syntax (e.g. 1h, 24h, 7d).
# How long a password-reset token stays usable after being emailed.
ACCOUNT_LIFECYCLE_RESET_TOKEN_EXPIRY=1h
# How long an email-verification token stays usable.
ACCOUNT_LIFECYCLE_VERIFICATION_TOKEN_EXPIRY=24h
# Scheduled purge of expired/used password-reset and email-verification tokens. Safe to
# leave enabled in production; the test suite disables it separately.
ACCOUNT_LIFECYCLE_CLEANUP_ENABLED=true
# Standard 6-field cron (seconds included), evaluated in the server's local time zone.
ACCOUNT_LIFECYCLE_CLEANUP_CRON=0 30 3 * * *
# How long a used/expired token row is kept around after it stops being usable, before
# the cleanup job deletes it.
ACCOUNT_LIFECYCLE_CLEANUP_RETENTION=7d
