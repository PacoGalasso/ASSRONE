# Environment variables read by the backend (see application.properties,
# application-production.properties). Copy this file to .env (already gitignored),
# or set these as real environment variables in your deployment platform — never
# commit an actual .env file or real secret values anywhere in the repository.
#
# None of the values below are real secrets: they are either placeholders you must
# replace, or the safe defaults already used when a variable is left unset.

# ---- Spring profile -------------------------------------------------------------
# Required in production. Left unset, the application defaults to the "local"
# profile (see application.properties) — safe for a developer's machine, but never
# what a real deployment wants: SPRING_PROFILES_ACTIVE=production activates
# application-production.properties and ProductionSecurityGuard's startup checks.
SPRING_PROFILES_ACTIVE=production

# ---- Database (spring-boot standard relaxed binding, not declared in any
#      application*.properties file in this repo) --------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/assrone_db
SPRING_DATASOURCE_USERNAME=changeme
SPRING_DATASOURCE_PASSWORD=changeme

# ---- JWT signing key --------------------------------------------------------------
# Must decode from Base64 to exactly 48 bytes (HS384). Generate one with, e.g.:
#   openssl rand -base64 48
# The placeholder below is deliberately NOT valid Base64/NOT 48 bytes: JwtService
# refuses to start with it, in every profile, so it can never be forgotten by accident.
JWT_SECRET=changeme-generate-with-openssl-rand-base64-48

# ---- SMTP (Infomaniak) ------------------------------------------------------------
SMTP_PASSWORD=changeme

# ---- CORS ---------------------------------------------------------------------------
# Comma-separated list of the real deployed frontend origin(s). Required in production
# (no default there — see application-production.properties); defaults to
# http://localhost:4200 everywhere else. Never "*" — CorsProperties refuses to start
# the application, in every profile, if this contains a wildcard.
CORS_ALLOWED_ORIGINS=https://assrone.ch

# ---- Refresh-token cookie ----------------------------------------------------------
# All optional; shown here with their defaults. See RefreshCookieProperties and
# ProductionSecurityGuard for the validation/startup checks on these.
REFRESH_COOKIE_NAME=refresh_token
# Defaults to true in production (application-production.properties), false elsewhere.
# ProductionSecurityGuard refuses to start the application if this resolves to false
# while SPRING_PROFILES_ACTIVE=production.
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAME_SITE=Lax
REFRESH_COOKIE_PATH=/auth

# ---- Reverse proxy (only if one sits in front of the app in production) -----------
# Comma-separated list of IPs/CIDR ranges allowed to supply X-Forwarded-For. Leave
# unset (the default everywhere) if there is no reverse proxy in front of the app.
# Never a wildcard/0.0.0.0/0-style range.
TRUSTED_PROXIES=
